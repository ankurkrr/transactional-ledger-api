# ==============================================================================
# Transactional Ledger API — Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# Environment Mode: 'development', 'test', 'staging', 'production'
ENVIRONMENT=development

# Access Control Safety Gate
# NOTE: In 'production', this MUST be set to false. If set to true in production, startup fails immediately.
ALLOW_UNAUTHENTICATED_ACCESS=true

# Database Connectivity (PostgreSQL 16+)
POSTGRES_HOST=localhost
# Change POSTGRES_PORT to 5434 if port 5432 is already occupied by a local database service:
POSTGRES_PORT=5432
POSTGRES_DB=ledger

# Database User Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_MIGRATOR_USER=ledger_migrator
POSTGRES_MIGRATOR_PASSWORD=migrator_password
POSTGRES_APP_USER=ledger_app
POSTGRES_APP_PASSWORD=postgres

# Application Runtime Database Connection URI (Uses restricted DML role: ledger_app)
DATABASE_URL=postgresql+asyncpg://ledger_app:postgres@localhost:5432/ledger

# Database Migration Connection URI (Uses DDL role: ledger_migrator)
MIGRATION_DATABASE_URL=postgresql+asyncpg://ledger_migrator:migrator_password@localhost:5432/ledger

# Automated Integration Test Database Connection URI (Isolated test database: ledger_test)
TEST_DATABASE_URL=postgresql+asyncpg://ledger_app:postgres@localhost:5432/ledger_test

# Application Security Secret Key (Must be >= 32 characters in staging/production)
SECRET_KEY=dev_insecure_default_secret_key_minimum_32_characters_long

# Logging Severity Threshold: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_LEVEL=INFO
API_PORT=8000
